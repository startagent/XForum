{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cforum",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "cforum_db",
			"database_name": "cforum-db",
			"database_id": "74957297-e752-4142-9148-12a653da272c",
			"remote": true,
			"migrations_dir": "migrations"
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"workers_dev": true,
	"env": {
		"development": {
			"vars": {
				"WORKER_URL": "http://localhost:8787"
			}
		}
	}
}
